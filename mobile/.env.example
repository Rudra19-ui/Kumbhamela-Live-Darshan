# Copy to .env (do not commit .env).
#
# Local Wi‑Fi (Expo Go / dev):
#   EXPO_PUBLIC_API_URL=http://192.168.1.4:8000
#
# Production / public API (APK must be rebuilt after changing this):
#   EXPO_PUBLIC_API_URL=https://api.yourdomain.com
# Render (example — use your service hostname):
#   EXPO_PUBLIC_API_URL=https://kumbhconnect-api.onrender.com
#
# Android emulator → host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://192.168.1.4:8000