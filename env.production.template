# Copy this file to ".env.production" in the SAME folder as docker-compose.prod.yml
# (repo root). Do NOT commit .env.production — it contains secrets.

# --- Django ---
SECRET_KEY=generate-a-long-random-string-here
DEBUG=False
ALLOWED_HOSTS=your.domain.com,123.45.67.89

# --- Database (matches docker-compose.prod.yml service "db") ---
DB_NAME=kumbhconnect
DB_USER=kumbh
DB_PASSWORD=choose-a-strong-db-password
DB_HOST=db
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS (browser admin / web dashboards). Mobile RN usually works without this. ---
CORS_ALLOWED_ORIGINS=https://your.domain.com

# --- Mobile dev flows (turn OFF for real production) ---
# APK testing without OTP / Razorpay:
ENABLE_DEV_LOGIN=1
SKIP_PAYMENT_CONFIRMATION=1

# --- Optional: use SQLite only for quick smoke tests (NOT recommended with compose db) ---
# USE_SQLITE=0

# --- Celery: compose file does not start workers; set eager if you need async tasks without workers ---
CELERY_EAGER=1
