SECRET_KEY=change-me
DEBUG=True
# Include your PC's Wi‑Fi IPv4 when the phone app calls http://<that-ip>:8000 (Gunicorn uses production settings).
ALLOWED_HOSTS=localhost,127.0.0.1
# Or keep ALLOWED_HOSTS as above and add only LAN IPs here (merged in production.py):
LAN_ALLOWED_HOSTS=192.168.1.42
